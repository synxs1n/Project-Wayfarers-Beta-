{
  "name": "project-aurelis-wayfarers",
  "productName": "Project Aurelis Wayfarers",
  "version": "0.4.4",
  "description": "Turn-based pixel art medieval fantasy RPG.",
  "author": "Jason",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "sh build.sh",
    "electron": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "firebase": "^10.12.2",
    "@capacitor-firebase/authentication": "^6.3.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.synxs1n.wayfarers",
    "productName": "Project Aurelis Wayfarers",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "icons/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon-only.png"
    },
    "nsis": {
      "oneClick": true
    },
    "artifactName": "Wayfarers-${version}-${os}.${ext}"
  }
}