rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own data.
    match /profile/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /saves/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /feedback/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /feedback/{uid}/reports/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    // Daily Trial leaderboard: any signed in player can read, only the owner can write their own row.
    match /scores/{uid} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid; }
  }
}
